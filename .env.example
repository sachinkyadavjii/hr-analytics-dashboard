# Copy this file to .env for local development and fill in real values.
# Never commit your actual .env file.

# A long, random string used to sign session cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-secret-key

# Leave unset to use local SQLite (instance/database.db).
# On Render, set this to the PostgreSQL connection string provided by
# your Render Postgres instance (Render also accepts the postgres:// form).
# DATABASE_URL=postgresql://user:password@host:5432/dbname
